# EstatePulse AI settings. Copy to ~/.estatepulse.env; scripts/restart_app.sh passes it to the container.
# Only the three *_PASSWORD lines are required for a demo; everything else degrades gracefully when empty.

# --- model (Nemotron on vLLM, started by ./start_nemotron.sh) ---
NEMOTRON_BASE_URL=http://localhost:8000/v1
JEV_BACKEND=vllm

# --- sign-in accounts (app/rbac.py) and signing secrets ---
ADMIN_EMAIL=admin@estatepulse.demo
ADMIN_PASSWORD=
REALTOR_EMAIL=realtor@estatepulse.demo
REALTOR_PASSWORD=
CLIENT_EMAIL=client@estatepulse.demo
CLIENT_PASSWORD=
SESSION_SECRET=          # any long random string, e.g. openssl rand -hex 32
PORTAL_SECRET=           # signs client portal links
PORTAL_BASE_URL=http://localhost:8501

# --- Databricks (optional; without it the app uses data/live/) ---
DATABRICKS_HOST=         # https://<workspace>.cloud.databricks.com
DATABRICKS_TOKEN=        # personal access token
DATABRICKS_WAREHOUSE_ID= # last part of the SQL warehouse HTTP path
DATABRICKS_CATALOG=workspace
DATA_SOURCE=databricks   # agents read Databricks gold when configured, else local

# --- free API keys (optional) ---
ORS_API_KEY=             # openrouteservice.org: real drive times for the Commute agent
CENSUS_API_KEY=          # api.census.gov/data/key_signup.html: home values for new cities
FBI_API_KEY=             # api.data.gov/signup: crime data for new cities (DEMO_KEY otherwise)
RENTCAST_API_KEY=        # rentcast.io free tier: live listings (50 requests/month)
FRED_API_KEY=            # optional; FRED's keyless CSV is used otherwise

# --- email for portal invites (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
